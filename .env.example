# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres (Railway-style). Leave blank to use local SQLite.
DATABASE_URL=

# Public base URL (used for absolute links in emails, OG, etc.)
SITE_BASE_URL=http://localhost:8000

# --- Claude API (intent extraction for conversational search) ---
ANTHROPIC_API_KEY=

# --- Google Places API (business ingestion) ---
GOOGLE_PLACES_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=consulte. <hola@consulte.app>
